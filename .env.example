POSTGRES_DB=goofy
POSTGRES_USER=goofy
POSTGRES_PASSWORD=replace-with-long-random-secret
OWNER_DASHBOARD_TOKEN=
AGENT_RUNTIME_TOKEN=replace-with-long-random-agent-token
OWNER_TELEGRAM_IDS=
AGENT_OS_BIND_ADDRESS=0.0.0.0
AGENT_OS_PORT=9999
GOOFY_DATA_DIR=/home/goofy/agent-os/data
# Optional contextual-memory provider. Never commit the real key.
MEM0_API_KEY=
AGENTMAIL_EMAIL=goofyboy@agentmail.to
AGENTMAIL_API_KEY=
# Browser-visible, origin-restricted Infura project ID; never use a secret key here.
INFURA_PROJECT_ID=
# Server-only Ethereum Mainnet RPC URL. Do not expose, log, or commit it.
ETHEREUM_RPC_URL=
# Public or authenticated Base Mainnet RPC used for dedicated-wallet balances.
BASE_RPC_URL=https://mainnet.base.org
# Host-only protected path. Compose mounts it read-only into the application.
AGENT_WALLET_KEY_PATH=/home/goofy/.hermes/goofy-agent-wallet.key
# PayPal server credentials. Use sandbox by default; set PAYPAL_ENVIRONMENT=live
# only after owner-completed PayPal setup. Webhook verification requires its ID.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
