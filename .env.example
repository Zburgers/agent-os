POSTGRES_DB=goofy
POSTGRES_USER=goofy
POSTGRES_PASSWORD=replace-with-long-random-secret
OWNER_DASHBOARD_TOKEN=
AGENT_RUNTIME_TOKEN=replace-with-long-random-agent-token
# Comma-separated owner chat IDs used by app and supervisor notifications.
OWNER_TELEGRAM_IDS=
# Absolute in-container path to a dedicated mode-0400/0600 HMAC secret file.
# Provision only after the exact notification/deployment approvals are granted.
APPROVAL_TOKEN_SECRET_FILE=
# Approved, unexpired standing message-policy approval.
TELEGRAM_NOTIFICATION_POLICY_APPROVAL_ID=
AGENT_OS_RELAY_BASE_URL=http://127.0.0.1:9999
AGENT_OS_RELAY_TOKEN_FILE=/home/goofy/.hermes/agent-os-token
AGENT_OS_RELAY_POLL_MS=2000
# Host-only mode-0600 file read by the Agent OS Telegram relay; never pass the
# bot token into the app or supervisor containers.
TELEGRAM_BOT_TOKEN_FILE=/home/goofy/.hermes/telegram-bot-token
TELEGRAM_POLL_TIMEOUT_SECONDS=1
# Host-only mode-0600 file for the separate Hermes control bot. Never reuse
# TELEGRAM_BOT_TOKEN_FILE: Telegram permits only one getUpdates consumer per bot.
HERMES_TELEGRAM_BOT_TOKEN_FILE=/home/goofy/.hermes/hermes-telegram-bot-token
AGENT_OS_BIND_ADDRESS=0.0.0.0
AGENT_OS_PORT=9999
GOOFY_DATA_DIR=/home/goofy/agent-os/data
# Optional contextual-memory provider. Never commit the real key.
MEM0_API_KEY=
AGENTMAIL_EMAIL=goofyboy@agentmail.to
AGENTMAIL_API_KEY=
# Browser-visible, origin-restricted Infura project ID; never use a secret key here.
INFURA_PROJECT_ID=
# Server-only Ethereum Mainnet RPC URL. Do not expose, log, or commit it.
ETHEREUM_RPC_URL=
# Public or authenticated Base Mainnet RPC used for dedicated-wallet balances.
BASE_RPC_URL=https://mainnet.base.org
# Host-only protected path. Compose mounts it read-only into the application.
AGENT_WALLET_KEY_PATH=/home/goofy/.hermes/goofy-agent-wallet.key
# PayPal server credentials. Use sandbox by default; set PAYPAL_ENVIRONMENT=live
# only after owner-completed PayPal setup. Webhook verification requires its ID.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
