{
  "name": "goofy-agent-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "test:watch": "node --test --watch --experimental-strip-types 'test/**/*.test.ts'",
    "test:integration": "scripts/test-postgres-integration.sh",
    "test:browser": "scripts/test-browser-workboard.sh",
    "backup": "scripts/backup.sh",
    "test:restore": "scripts/test-restore.sh",
    "test:mem0": "scripts/test-mem0-cloud.sh",
    "experiment:internal": "docker compose exec -T app node --experimental-strip-types src/internal-experiment.ts",
    "test:restart": "scripts/test-supervisor-restart.sh",
    "start": "node --experimental-strip-types src/server.ts",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "worker": "node --experimental-strip-types src/worker.ts",
    "supervisor": "node --experimental-strip-types src/supervisor.ts",
    "check": "esbuild src/*.ts --outdir=/tmp/goofy-agent-os-check --platform=node --format=esm --log-level=error",
    "build": "npm run check && npm run build:wallet-client",
    "build:wallet-client": "esbuild src/wallet-client.ts --bundle --platform=browser --format=esm --external:/assets/metamask-connect.js --outfile=public/wallet-client.js && esbuild node_modules/@metamask/connect-evm/dist/browser/es/connect-evm.mjs --bundle --platform=browser --format=esm --outfile=public/metamask-connect.js"
  },
  "dependencies": {
    "@google/jules": "^0.1.42",
    "@metamask/connect-evm": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ethers": "^6.17.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
